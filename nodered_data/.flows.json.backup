    {
        "id": "bbcca26c68f9ca4b",
        "type": "debug",
        "z": "af2032c9eba36021",
        "name": "smartparking-raw-payload",
        "active": false,
        "tosidebar": true,
        "console": false,
        "tostatus": false,
        "complete": "payload",
        "targetType": "msg",
        "statusVal": "",
        "statusType": "auto",
        "x": 150,
