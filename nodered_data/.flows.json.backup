        "type": "function",
        "z": "af2032c9eba36021",
        "name": "Filter non 200 status codes",
        "func": "// Filter out messages with statusCode equal to 200\nif (msg.statusCode == 200) {\n    msg.dashboard_id = JSON.parse(msg.payload).id.id;\n    msg.payload = \"Dashboard for device \" + msg.name + \" created successfully with id \" + msg.dashboard_id;\n} else {\n    msg.payload = msg;\n}\n\nreturn msg;",
