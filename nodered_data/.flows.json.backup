    {
        "id": "83581f532572ad43",
        "type": "function",
        "z": "af2032c9eba36021",
        "name": "Set telemetry URL",
        "func": "// Retrieve the current counter value from global context\nvar msg_count = global.get(\"message_count\") || 0;\n\n// Increment the counter\nmsg_count += 1;\n\n// Save the updated counter value back to global context\nglobal.set(\"message_count\", msg_count);\n\n// Save msg_count to the JSON payload\nmsg.payload.data.msg_count = msg_count;\nmsg.payload.data.count = 1;\n\n// Extract token from message payload\nvar token = msg.payload.device_id;\n\n// Construct URL with token\nmsg.url = \"http://licenta-mytb-1:9090/api/v1/token_\" + token + \"/telemetry\";\n\n// Send only telemetry data\nmsg.payload = msg.payload.data\n\n// Return modified message object\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 810,
        "y": 340,
        "wires": [
            [
                "7a310c1fd9108704",
                "fbfdc00aa210aab1"
            ]
        ]
    },
