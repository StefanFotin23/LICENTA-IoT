ype_str: \"int\", no_fields: 3, precision: 0 }, { id: 183, type: 1, ascii: \"MB_IR\", type_str: \"int\", no_fields: 3, precision: 0 }, { id: 184, type: 1, ascii: \"CB_RPM\", type_str: \"int\", no_fields: 1, precision: 0 }, { id: 185, type: 1, ascii: \"CB_VS\", type_str: \"int\", no_fields: 1, precision: 0 }, { id: 186, type: 1, ascii: \"CB_FR\", type_str: \"int\", no_fields: 1, precision: 0 }, { id: 187, type: 0, ascii: \"CB_FL\", type_str: \"uint8_t\", no_fields: 1, precision: 0 }, { id: 188, type: 0, ascii: \"CB_TP\", type_str: \"uint8_t\", no_fields: 1, precision: 0 }, { id: 189, type: 1, ascii: \"CB_FP\", type_str: \"int\", no_fields: 1, precision: 0 }, { id: 190, type: 1, ascii: \"PM_BIN\", type_str: \"int\", no_fields: 24, precision: 0 }, { id: 191, type: 1, ascii: \"PM_BINL\", type_str: \"int\", no_fields: 16, precision: 0 }, { id: 192, type: 1, ascii: \"PM_BINH\", type_str: \"int\", no_fields: 8, precision: 0 }, { id: 193, type: 2, ascii: \"USER_TC\", type_str: \"double\", no_fields: 1, precision: 2 }, { id: 194, type: 2, ascii: \"AIR_TC\", type_str: \"double\", no_fields: 1, precision: 2 }, { id: 195, type: 2, ascii: \"SI4B1_TC\", type_str: \"double\", no_fields: 1, precision: 2 }, { id: 196, type: 4, ascii: \"COUNTER\", type_str: \"uint32_t\", no_fields: 1, precision: 0 }, { id: 197, type: 4, ascii: \"FEVER_COUNTER\", type_str: \"uint32_t\", no_fields: 1, precision: 0 }, { id: 198, type: 2, ascii: \"THRESHOLD\", type_str: \"double\", no_fields: 1, precision: 2 }, { id: 199, type: 0, ascii: \"RESULT\", type_str: \"uint8_t\", no_fields: 1, precision: 0 }])\n\nfunction readString(buffer, offset) {\n    const len = buffer.readUint8(offset)\n    return buffer.slice(offset, offset + len).toString('ascii')\n}\n\nfunction getStringSize(buffer, offset) {\n    const len = buffer.readUint8(offset)\n    return len\n}\n\nfunction parse_tiny_wasp(payload, base) {\n    const wasp_sensors = flow.get('wasp_sensors')\n    const buff = Buffer.from(payload, base)\n    //node.warn(buff)\n    buff.readString = (offset) => readString(buff, offset);\n    buff.getStringSize = (offset) => getStringSize(buff, offset)\n    const seq = buff.readUint8();\n    const len = buff.byteLength;\n    let offset = 2\n    let data = {}\n    while (offset < len) {\n        const sensor_id = buff.readUint8(offset)\n        //node.warn(\"Sensor ID = \" + sensor_id);\n        offset += 1\n        const sensor = wasp_sensors[sensor_id]\n        let parser = null;\n        let sizeof_element = 0\n        switch (sensor.type) {\n            case 0: // uint8\n                parser = (read_offset) => buff.readUint8(read_offset)\n                sizeof_element = 1;\n                break;\n            case 1: // int\n                parser = (read_offset) => buff.readInt16LE(read_offset)\n                sizeof_element = 2\n                break;\n            case 2: // double\n                parser = (read_offset) => buff.readFloatLE(read_offset)\n                sizeof_element = 4\n                break;\n            case 3: // string (no multiple string supported)\n                parser = (read_offset) => buff.readString(read_offset)\n                sizeof_element = buff.getStringSize(offset)\n                break;\n            case 4: // uint32\n                parser = (read_offset) => buff.readUint32LE(read_offset)\n                sizeof_element = 4\n                break;\n        }\n        let new_data = {}\n        if (sensor.no_fields == 1) {\n            new_data[sensor.ascii] = parser(offset)\n            offset += sizeof_element\n        } else {\n            for (let i = 0; i < sensor.no_fields; i++) {\n                let value_name = sensor.ascii + i;\n                new_data[value_name] = parser(offset)\n                offset += sizeof_element\n            }\n        }\n\n        data = { ...data, ...new_data }\n    }\n    return data\n}\n\n// Get decoded data\nvar data = msg.payload.uplink_message.frm_payload;\nmsg.payload = parse_tiny_wasp(data, 'base64');\n\n// Get device_id\nvar topic = msg.topic;\nvar regex = /^v3\\/libelium\\/devices\\/(.+)\\/up$/;\nvar match = regex.exec(topic);\n\nif (match && match.length > 1) {\n    var device_id = match[1];\n\n    if (msg.payload.end_device_ids &&\n        (device_id !== msg.payload.end_device_ids.device_id ||\n        device_id === null)\n    ) {\n        node.warn(\"Device_id = \" + device_id);\n        device_id = msg.payload.end_device_ids.device_id;\n    }\n} else {\n    node.warn(\"Nu s-a putut extrage device_id din topic.\");\n}\n\n// Return relevant data\nmsg.payload = {\n    device_id: device_id,\n    data: msg.payload\n}\n\nreturn msg;",
