    {
        "id": "85f86968021b0ef6",
        "type": "function",
        "z": "af2032c9eba36021",
        "name": "smartparking-decoder",
        "func": "function decode_smart_parking(payload, base) {\n    const buff = Buffer.from(payload, base)\n    const first_nibble_bin = ((buff[0] & 0xF0) >> 4).toString(2).padStart(4, '0')\n    let header_data = {\n        'parking_slot_status': Number(first_nibble_bin[0]),\n        'battery_state': Number(first_nibble_bin[1]),\n        'ack': Number(first_nibble_bin[2]),\n        'recalibration': Number(first_nibble_bin[3]),\n        'frame_type': (buff[0] & 0x0F),\n        'sequence': buff.readUint8(1),\n    }\n\n    let frame_data;\n\n    switch (header_data['frame_type']) {\n        case 0:\n            frame_data = {\n                'radar_error': buff.readUint8(2),\n                'temperature': buff.readInt8(3),\n                'timestamp_hh': buff.readInt8(4),\n                'timestamp_mm': buff.readUint8(5),\n                'd1': buff.readUint16BE(6),\n                'a1': buff.readUint16BE(8),\n                'n_reflections': buff.readUint8(10)\n            }\n            break;\n        case 1:\n        case 7:\n            frame_data = {\n                'radar_error': buff.readUint8(2),\n                'temperature': buff.readInt8(3),\n                'timestamp_hh': buff.readUint8(4),\n                'timestamp_mm': buff.readUint8(5),\n                'd1': buff.readUint16BE(6),\n                'a1': buff.readUint16BE(8),\n                'battery_raw': buff.readUint8(10),\n                'battery': buff.readUint8(10) * 4 + 2800,\n            }\n            break\n        case 4:\n            frame_data = {\n                'firmware_version': buff.readUint8(2),\n                'battery_raw': buff.readUint8(3),\n                'battery': buff.readUint8(3) * 4 + 2800,\n                'radar_threshold': buff.readUint8(4),\n                'radar_range_start': buff.readUint8(5),\n                'radar_range_length': buff.readUint8(6),\n            }\n            break;\n        case 5:\n            frame_data = {\n                'time_sleep_min': buff.readUint8(2),\n                'time_sleep_secs': buff.readUint8(3),\n                'time_keep_alive': buff.readUint8(4),\n                'nm_mode': buff.readUint8(5),\n                'nm_start_hour': buff.readUint8(6),\n                'nm_duration': buff.readUint8(7),\n                'nm_sleep_time': buff.readUint8(8),\n                'nm_keep_alive': buff.readUint8(9),\n            }\n            break;\n        case 2:\n            frame_data = {\n                'flag_rtc': buff.readUint8(4)\n            }\n    }\n\n    if (header_data['frame_type'] === 4 || header_data['frame_type'] === 5) {\n        header_data['parking_slot_status'] = null;\n    }\n\n    return {\n        'header_data': header_data,\n        'frame_data': frame_data\n    }\n}\n\n// Get decoded data\nvar data = msg.payload.uplink_message.frm_payload;\nmsg.payload = decode_smart_parking(data, 'base64');\n\n// Get device_id\nvar topic = msg.topic;\nvar regex = /^v3\\/smartparking\\/devices\\/(.+)\\/up$/;\nvar match = regex.exec(topic);\n\nif (match && match.length > 1) {\n    var device_id = match[1];\n\n    if (msg.payload.end_device_ids &&\n        (device_id !== msg.payload.end_device_ids.device_id ||\n        device_id === null)\n    ) {\n        node.warn(\"Device_id = \" + device_id);\n        device_id = msg.payload.end_device_ids.device_id;\n    }\n} else {\n    node.warn(\"Nu s-a putut extrage device_id din topic.\");\n}\n\n// Return relevant data\nmsg.payload = {\n    device_id,\n    ...msg.payload\n}\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 580,
        "y": 780,
        "wires": [
