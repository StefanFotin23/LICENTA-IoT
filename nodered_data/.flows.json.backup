    },
    {
        "id": "24be6ead0b36b68d",
        "type": "function",
        "z": "af2032c9eba36021",
        "name": "function 1",
        "func": "var deviceSet = new Set();\n\ndeviceSet.add(msg.payload.device_id);\n\nmsg.payload = Array.from(deviceSet);\n\nreturn msg;",
        "outputs": 1,
