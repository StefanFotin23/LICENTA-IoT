    {
        "id": "881971e08d55e9dc",
        "type": "function",
        "z": "af2032c9eba36021",
        "name": "Set Monitorization Server Side Attributes",
        "func": "var access_token = 'token_monitorization';\nvar deviceId = global.get(\"monitorization_id\");\n\nvar url = \"http://licenta-mytb-1:9090/api/plugins/telemetry/DEVICE/\" + deviceId + \"/SERVER_SCOPE?accessToken=\" + access_token;\n\nvar attributesPayload = {\n    \"realCount\": 0,\n    \"missedMessages\": 0\n};\n\n// Prepare the message for the HTTP request\nmsg.url = url;\nmsg.bearer_token = global.get(\"bearer_token\");\nmsg.payload = attributesPayload;\n\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 860,
        "y": 900,
