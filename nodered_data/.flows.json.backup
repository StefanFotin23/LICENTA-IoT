    {
        "id": "16b3554f678eba0d",
        "type": "function",
        "z": "af2032c9eba36021",
        "name": "Initial Date",
        "func": "// Obține timestamp-ul curent\nvar timestamp = Date.now();\n\n// Verifică dacă există deja \"date_ms\" în contextul global\nvar date_ms = global.get(\"date_ms\");\n\n// Creează un obiect Date folosind \"date_ms\" existent sau timestamp-ul curent\nvar date = date_ms ? new Date(date_ms) : new Date(timestamp);\n\n// Obține componentele datei\nvar day = date.getDate();\nvar month = date.getMonth() + 1; // Lunile sunt indexate de la 0\nvar year = date.getFullYear();\n\nvar hours = date.getHours() + 3;\nvar minutes = date.getMinutes();\n\n// Adaugă un zero în față dacă ziua, luna, orele sau minutele sunt mai mici de 10\nif (day < 10) {\n    day = '0' + day;\n}\nif (month < 10) {\n    month = '0' + month;\n}\nif (hours < 10) {\n    hours = '0' + hours;\n}\nif (minutes < 10) {\n    minutes = '0' + minutes;\n}\n\n// Construiește stringul final\nvar formattedDate = day + '-' + month + '-' + year + ' ' + hours + ':' + minutes;\n\nglobal.set(\"date\", formattedDate);\nglobal.set(\"date_ms\", date);\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 510,
        "y": 640,
        "wires": [
            [
                "fbfdc00aa210aab1"
            ]
        ]
    },
    {
        "id": "a40f2d1359124bfc",
        "type": "function",
        "z": "af2032c9eba36021",
        "name": "Process Monitorization Data",
        "func": "msg.date = global.get(\"date\");\nvar initialDateMs = global.get(\"date_ms\");\nvar messageCount = global.get(\"message_count\");\nvar currentDateMs = Date.now();\n\n// Calculate the elapsed time in hours and minutes\nvar elapsedTimeMs = currentDateMs - initialDateMs;\nvar elapsedTimeDays = elapsedTimeMs / (1000 * 60 * 60 * 24);\nvar elapsedTimeHours = elapsedTimeMs / (1000 * 60 * 60);\nvar elapsedTimeMinutes = elapsedTimeMs / (1000 * 60);\n\n// Calculate the message rates\nvar msgRateD = messageCount / elapsedTimeDays;\nvar msgRateH = messageCount / elapsedTimeHours;\nvar msgRateM = messageCount / elapsedTimeMinutes;\n\n// Attach the message rates to the message object\nmsg.msg_rate_h = msgRateH;\nmsg.msg_rate_m = msgRateM;\nmsg.msg_rate_d = msgRateD;\n\n// Construct URL with token\nvar token = 'monitorization';\nmsg.topic = token;\nmsg.url = \"http://licenta-mytb-1:9090/api/v1/token_\" + token + \"/telemetry\";\n\nvar msg_errors = global.get(\"msg_errors\") || 0;\nvar msg_sent = global.get(\"msg_sent\") || 0;\n\n// Send only telemetry data\nmsg.payload = {\n    \"msg_rate_h\": msg.msg_rate_h,\n    \"msg_rate_m\": msg.msg_rate_m,\n    \"msg_rate_d\": msg.msg_rate_d,\n    \"expected_count\": messageCount,\n    \"refreshable_count\": msg.count,\n    \"count\": 1,\n    \"msg_errors\": msg_errors,\n    \"msg_sent\": msg_sent\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1120,
        "y": 700,
        "wires": [
            [
