    {
        "id": "a9a6628c6ad2c74b",
        "type": "function",
        "z": "af2032c9eba36021",
        "name": "Parse CSV input data",
        "func": "// Sample CSV data\nconst csvData = `name,type,access_token,label\ners-eye01,ers-eye,token_ers-eye01,elsys\ners-eye02,ers-eye,token_ers-eye02,elsys\ners-eye03,ers-eye,token_ers-eye03,elsys\ners-eye04,ers-eye,token_ers-eye04,elsys\ners-eye05,ers-eye,token_ers-eye05,elsys\ners-eye06,ers-eye,token_ers-eye06,elsys\ners-eye07,ers-eye,token_ers-eye07,elsys\ners-eye08,ers-eye,token_ers-eye08,elsys\ners-eye09,ers-eye,token_ers-eye09,elsys\ners-eye10,ers-eye,token_ers-eye10,elsys\ners-eye11,ers-eye,token_ers-eye11,elsys\ners-voc01,ers-voc,token_ers-voc01,elsys\ners-voc02,ers-voc,token_ers-voc02,elsys\ners-voc03,ers-voc,token_ers-voc03,elsys\ners-voc04,ers-voc,token_ers-voc04,elsys\ners-voc05,ers-voc,token_ers-voc05,elsys\ners-gas01,ers-gas,token_ers-gas01,elsys\ners-gas02,ers-gas,token_ers-gas02,elsys\ners-gas03,ers-gas,token_ers-gas03,elsys\ners-gas04,ers-gas,token_ers-gas04,elsys\ners-gas05,ers-gas,token_ers-gas05,elsys\ners-gas06,ers-gas,token_ers-gas06,elsys\nsap1,sap,token_sap1,libelium-sap\nsap2,sap,token_sap2,libelium-sap\nsap3,sap,token_sap3,libelium-sap\nsap4,sap,token_sap4,libelium-sap\nssec1,ssec,token_ssec1,libelium-ssec\nssec2,ssec,token_ssec2,libelium-ssec\nssec3,ssec,token_ssec3,libelium-ssec\nsp1,sp,token_sp1,smartparking\nsp2,sp,token_sp2,smartparking\nsp3,sp,token_sp3,smartparking\nsp4,sp,token_sp4,smartparking\nsp5,sp,token_sp5,smartparking\nsp6,sp,token_sp6,smartparking\nsp7,sp,token_sp7,smartparking\nsp8,sp,token_sp8,smartparking\nsp9,sp,token_sp9,smartparking\nsp10,sp,token_sp10,smartparking\nmonitorization,stats,token_monitorization,msg_stats`;\n\n// Save the Bearer token\nvar token = msg.payload;\ntoken = \"Bearer \" + JSON.parse(token).token;\nglobal.set(\"bearer_token\", token);\nmsg.token = token;\n\n// Split the CSV data into lines\nconst lines = csvData.trim().split('\\n');\n\n// Extract the header line\nconst headers = lines[0].split(',');\n\n// Initialize an array to hold the JSON objects\nconst devices = [];\n\n// Iterate over the remaining lines and create JSON objects\nfor (let i = 1; i < lines.length; i++) {\n    const values = lines[i].split(',');\n    const device = {};\n    \n    // Create a JSON object using the headers as keys and the values as the data\n    for (let j = 0; j < headers.length; j++) {\n        device[headers[j]] = values[j];\n    }\n    \n    // Add the JSON object to the array\n    devices.push(device);\n}\n\n// Set the payload to the array of JSON objects\nmsg.payload = devices;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 360,
        "y": 1300,
        "wires": [
            [
                "fe4d322122cc093f",
                "1acbf8ae64982df3"
            ]
        ]
    },
