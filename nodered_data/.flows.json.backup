    {
        "id": "298593d17bed3ec9",
        "type": "function",
        "z": "af2032c9eba36021",
        "name": "Create Device",
        "func": "var name = msg.payload.name;\nvar type = msg.payload.type;\nvar access_token = msg.payload.access_token;\nvar label = msg.payload.label;\n\n// Save the information for next messages\nmsg.name = name;\nmsg.type = type;\nmsg.access_token = access_token;\nmsg.label = label;\n\nmsg.url = \"http://licenta-mytb-1:9090/api/device?accessToken=\" + access_token;\n\nmsg.payload = {\n    \"name\": name,\n    \"type\": type,\n    \"label\": label,\n    \"deviceData\": {\n      \"configuration\": {\n        \"type\": \"DEFAULT\"\n      },\n      \"transportConfiguration\": {\n        \"type\": \"DEFAULT\"\n      }\n    },\n    \"additionalInfo\": {},\n    \"firmwareId\": null,\n    \"softwareId\": null,\n    \"externalId\": null\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
