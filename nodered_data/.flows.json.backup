        "type": "function",
        "z": "af2032c9eba36021",
        "name": "msg_errors & msg_sent",
        "func": "var msg_errors = global.get(\"msg_errors\") || 0;\nvar msg_sent = global.get(\"msg_sent\") || 0;\n\nvar fail_rate = msg_errors / (msg_errors + msg_sent) * 100;\nmsg.payload = \"Number of messages failed to be send is: \" + msg_errors + \" / \" + msg_sent + \", fail rate is: \" + fail_rate + \"%\";\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
