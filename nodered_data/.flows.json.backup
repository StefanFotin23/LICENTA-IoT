    {
        "id": "725759200a8d4933",
        "type": "function",
        "z": "af2032c9eba36021",
        "name": "Filter non 200 status codes",
        "func": "// Filter out messages with statusCode equal to 200\nif (msg.statusCode == 200) {\n    msg.payload = msg.topic + \"   OK\";\n\n    if (msg.topic != \"monitorization\") {\n        // Increment sent messages counter\n        var msg_sent = global.get(\"msg_sent\") || 0;\n        msg_sent = msg_sent + 1;\n        global.set(\"msg_sent\", msg_sent);\n    }\n} else {\n    msg.payload = msg;\n\n    if (msg.topic != \"monitorization\") {\n        // Increment the msg_errors counter\n        var msg_errors = global.get(\"msg_errors\") || 0;\n        msg_errors = msg_errors + 1;\n        global.set(\"msg_errors\", msg_errors);\n    }\n}\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1180,
